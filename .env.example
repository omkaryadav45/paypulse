# Database configuration
# Local (SQLite) — good for local development
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# Turso (libSQL) example — replace with your Turso values for production
# DATABASE_URL="libsql://<your-db-id>.turso.io"
# DATABASE_AUTH_TOKEN="<your-turso-auth-token>"

# Session signing secret — use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# AI Assistant — OpenAI API key (optional; leave empty to disable AI features)
OPENAI_API_KEY=""

# Notes:
# - To use Turso: create a database on app.turso.tech, copy the `libsql://...` URL
#   and generate an auth token. Set `DATABASE_URL` and `DATABASE_AUTH_TOKEN` in
#   your deployment platform (Vercel) or in a local `.env` when testing.
# - For production, do NOT commit your real `.env` file to git. Keep `.env.example`
#   as a template and add `.env` to your local environment.
