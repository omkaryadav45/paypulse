# Database — local SQLite by default.
# For Vercel/production, use Turso (libSQL) or Postgres and update this URL.
DATABASE_URL="file:./dev.db"

# Session signing secret — use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# AI Assistant — OpenAI API key (or swap provider in src/app/api/chat/route.ts).
# Leave empty to run the app without the AI feature.
OPENAI_API_KEY=""
